import sys
if sys.platform == "win32":
    sys.stdout.reconfigure(encoding="utf-8", errors="replace")

import torch
from datasets import Dataset
from transformers import AutoModelForCausalLM, AutoTokenizer
from trl import SFTConfig, SFTTrainer

# 1. Detección automática del hardware local
use_bf16 = False
use_fp16 = False
model_dtype = torch.float32

if torch.cuda.is_available():
    device = "cuda"
    if torch.cuda.is_bf16_supported():
        use_bf16 = True
        model_dtype = torch.bfloat16
        print("Usando GPU NVIDIA (CUDA) con BFloat16")
    else:
        use_fp16 = True
        model_dtype = torch.float32  # Con FP16 AMP los pesos base deben ser FP32
        print("Usando GPU NVIDIA (CUDA) con FP16")
elif torch.backends.mps.is_available():
    device = "mps"
    model_dtype = torch.float32
    print("Usando Apple Silicon (MPS)")
else:
    device = "cpu"
    model_dtype = torch.float32
    print("Usando CPU (modo lento)")

# 2. Modelo ligero para pruebas rápidas
model_id = "HuggingFaceTB/SmolLM-135M"

tokenizer = AutoTokenizer.from_pretrained(model_id)
if tokenizer.pad_token is None:
    tokenizer.pad_token = tokenizer.eos_token

model = AutoModelForCausalLM.from_pretrained(
    model_id,
    dtype=model_dtype,
).to(device)

# 3. Mini dataset de prueba en memoria
data = {
    "text": [
        "Pregunta: ¿Qué es la densidad de un perfume? Respuesta: Es la concentración de aceites esenciales en la mezcla.",
        "Pregunta: ¿Cómo macerar una fragancia? Respuesta: Se debe dejar reposar en un lugar oscuro y fresco.",
        "Pregunta: ¿Cuál es la función del fijador? Respuesta: Retardar la evaporación de las notas más volátiles."
    ]
}
train_dataset = Dataset.from_dict(data)

# 4. Configuración con SFTConfig (compatible con versiones recientes de TRL)
training_args = SFTConfig(
    output_dir="./mi_modelo_local",
    dataset_text_field="text",
    max_length=128,
    per_device_train_batch_size=1,
    gradient_accumulation_steps=1,
    num_train_epochs=3,
    learning_rate=5e-4,
    logging_steps=1,
    fp16=use_fp16,
    bf16=use_bf16,
    report_to="none",
    save_strategy="no"
)

# 5. Instanciar el Trainer
trainer = SFTTrainer(
    model=model,
    train_dataset=train_dataset,
    args=training_args
)

print("Iniciando entrenamiento...")
trainer.train()

# 6. Guardar localmente los pesos modificados
trainer.save_model("./mi_modelo_final")
tokenizer.save_pretrained("./mi_modelo_final")
print("Modelo guardado en ./mi_modelo_final")

# 7. Probar inferencia con lo recién entrenado
prompt = "Pregunta: ¿Cómo macerar una fragancia? Respuesta:"
inputs = tokenizer(prompt, return_tensors="pt").to(device)

model.config.use_cache = True
with torch.no_grad():
    output = model.generate(**inputs, max_new_tokens=30, pad_token_id=tokenizer.eos_token_id)

print("\n--- Respuesta del modelo local ---")
print(tokenizer.decode(output[0], skip_special_tokens=True))